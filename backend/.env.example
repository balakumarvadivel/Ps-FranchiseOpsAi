APP_NAME=FranchiseOps AI
ENV=development

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/franchiseops

SECRET_KEY=replace-this-with-a-long-random-string-before-deploying
ACCESS_TOKEN_EXPIRE_MINUTES=480

FRONTEND_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Email (optional). Leave blank to keep forgot-password returning the raw
# token in the API response instead of emailing it — fine for local dev,
# should be set for any real deployment.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@franchiseops.ai
SMTP_USE_TLS=true
